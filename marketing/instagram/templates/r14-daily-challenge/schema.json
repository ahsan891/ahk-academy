{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r14-daily-challenge — use 3 words in one sentence",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "number", "words", "task", "example", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 4, "maxLength": 24 },
    "number": { "type": "integer", "minimum": 1, "maximum": 999, "description": "Challenge number (use the day number if given)" },
    "words": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 2, "maxLength": 14 } },
    "task": { "type": "string", "minLength": 10, "maxLength": 56, "description": "Turkish instruction" },
    "example": { "type": "string", "minLength": 20, "maxLength": 100, "pattern": "==.+==", "description": "One natural sentence using all 3 words, each wrapped in ==double equals==" },
    "cta": { "type": "string", "minLength": 6, "maxLength": 50 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
