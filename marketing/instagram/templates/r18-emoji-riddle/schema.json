{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r18-emoji-riddle — guess the idiom from emojis",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "question", "emojis", "answer", "meaning_tr", "example", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 4, "maxLength": 24 },
    "question": { "type": "string", "minLength": 6, "maxLength": 34 },
    "emojis": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 8 }, "description": "Each item is ONE emoji" },
    "answer": { "type": "string", "minLength": 4, "maxLength": 30, "description": "The idiom or word" },
    "meaning_tr": { "type": "string", "minLength": 6, "maxLength": 60 },
    "example": { "type": "string", "minLength": 15, "maxLength": 80, "pattern": "==.+==", "description": "Example with the idiom wrapped in ==double equals==" },
    "cta": { "type": "string", "minLength": 6, "maxLength": 44 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
