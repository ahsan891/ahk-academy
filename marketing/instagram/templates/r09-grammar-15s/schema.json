{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r09-grammar-15s — one grammar rule under a 15-second timer",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "title", "formula", "rule_tr", "examples", "done", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 4, "maxLength": 26 },
    "title": { "type": "string", "minLength": 4, "maxLength": 30, "description": "Rule name, e.g. 'Present Perfect', 'Used to'" },
    "formula": { "type": "string", "minLength": 4, "maxLength": 40, "description": "Formula with parts joined by ' + ', e.g. 'have / has + V3'" },
    "rule_tr": { "type": "string", "minLength": 20, "maxLength": 95, "description": "When to use it, in Turkish, one sentence. **bold** the key condition." },
    "examples": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 10, "maxLength": 60, "pattern": "==.+==" }, "description": "Wrap the grammar form in ==double equals==; a short Turkish hint in brackets is OK" },
    "done": { "type": "string", "minLength": 4, "maxLength": 28, "description": "e.g. '15 saniyede öğrendin ✓'" },
    "cta": { "type": "string", "minLength": 4, "maxLength": 22 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
