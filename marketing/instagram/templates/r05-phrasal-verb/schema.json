{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r05-phrasal-verb — guess the meaning, 3 examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "verb", "ask", "meaning_en", "meaning_tr", "examples", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 4, "maxLength": 24 },
    "verb": { "type": "string", "minLength": 5, "maxLength": 16, "description": "The phrasal verb, lowercase, e.g. 'put off'" },
    "ask": { "type": "string", "minLength": 6, "maxLength": 26, "description": "Turkish guess prompt, e.g. 'Ne demek? Tahmin et'" },
    "meaning_en": { "type": "string", "minLength": 6, "maxLength": 46 },
    "meaning_tr": { "type": "string", "minLength": 4, "maxLength": 40 },
    "examples": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 15, "maxLength": 66, "pattern": "==.+==" }, "description": "Three short sentences; wrap the phrasal verb (any form) in ==double equals==" },
    "cta": { "type": "string", "minLength": 6, "maxLength": 44 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
