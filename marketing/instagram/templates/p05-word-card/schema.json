{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p05-word-card — dictionary-style word card",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "word", "ipa", "pos", "meaning_tr", "definition_en", "example", "synonyms", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 3, "maxLength": 20 },
    "word": { "type": "string", "minLength": 3, "maxLength": 16 },
    "ipa": { "type": "string", "minLength": 3, "maxLength": 24 },
    "pos": { "type": "string", "enum": ["noun", "verb", "adjective", "adverb", "phrase"] },
    "meaning_tr": { "type": "string", "minLength": 3, "maxLength": 44 },
    "definition_en": { "type": "string", "minLength": 15, "maxLength": 90 },
    "example": { "type": "string", "minLength": 15, "maxLength": 90, "pattern": "==.+==" },
    "synonyms": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string", "minLength": 2, "maxLength": 14 } },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
