{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p03-email-phrases — 5 professional email phrases carousel",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "title", "subtitle", "phrases", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 3, "maxLength": 20 },
    "title": { "type": "string", "minLength": 8, "maxLength": 44 },
    "subtitle": { "type": "string", "minLength": 20, "maxLength": 100 },
    "phrases": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["situation", "phrase", "tr"], "properties": {
      "situation": { "type": "string", "minLength": 4, "maxLength": 26, "description": "Turkish situation label" },
      "phrase": { "type": "string", "minLength": 10, "maxLength": 70 },
      "tr": { "type": "string", "minLength": 8, "maxLength": 80 }
    } } },
    "cta": { "type": "string", "minLength": 6, "maxLength": 40 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
