{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p07-ielts-tips — 6-slide IELTS tips carousel",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "title", "subtitle", "tips", "cta_title", "cta_body", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 3, "maxLength": 22 },
    "title": { "type": "string", "minLength": 8, "maxLength": 40, "description": "Completes the big number: '4' + title, e.g. 'Task 2'de Band 7 için kural'" },
    "subtitle": { "type": "string", "minLength": 10, "maxLength": 90 },
    "tips": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["title", "body", "examiner"], "properties": {
      "title": { "type": "string", "minLength": 6, "maxLength": 40 },
      "body": { "type": "string", "minLength": 30, "maxLength": 140, "description": "Turkish, practical, **bold** allowed" },
      "examiner": { "type": "string", "minLength": 20, "maxLength": 95, "description": "What the examiner sees / which band descriptor it affects" }
    } } },
    "cta_title": { "type": "string", "minLength": 8, "maxLength": 52 },
    "cta_body": { "type": "string", "minLength": 20, "maxLength": 100 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
