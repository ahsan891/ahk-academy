{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r07-pronunciation-trap — Turkish way vs native way",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "word", "ipa", "wrong_label", "wrong_syllables", "right_label", "right_syllables", "stress_index", "tip", "cta", "meta"],
  "properties": {
    "label": { "type": "string", "minLength": 4, "maxLength": 24 },
    "word": { "type": "string", "minLength": 3, "maxLength": 15, "description": "A word Turkish speakers mispronounce, capitalised" },
    "ipa": { "type": "string", "minLength": 3, "maxLength": 26 },
    "wrong_label": { "type": "string", "minLength": 4, "maxLength": 26, "description": "e.g. 'Türkler böyle söylüyor'" },
    "wrong_syllables": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 7 }, "description": "The typical wrong pronunciation written in Turkish letters, split into syllables" },
    "right_label": { "type": "string", "minLength": 4, "maxLength": 20, "description": "e.g. 'Natives say'" },
    "right_syllables": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 7 }, "description": "Native pronunciation respelled simply (Turkish-friendly letters or IPA-ish), stressed syllable in CAPITALS" },
    "stress_index": { "type": "integer", "minimum": 0, "maximum": 4, "description": "Index of the stressed syllable in right_syllables" },
    "tip": { "type": "string", "minLength": 20, "maxLength": 120, "description": "Turkish tip, **bold** key points" },
    "cta": { "type": "string", "minLength": 6, "maxLength": 44 },
    "meta": { "$ref": "../_shared/meta.schema.json" }
  }
}
